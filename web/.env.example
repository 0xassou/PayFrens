# ---------------------------------------------------------------------------
# Public — bundled into the client. Never put a secret behind NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Canonical origin of the deployment. Used for embed metadata, OG images and
# the farcaster.json manifest. No trailing slash.
NEXT_PUBLIC_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=PayFrens
NEXT_PUBLIC_APP_TAGLINE=Split bills in USDC on Base

# Coinbase Developer Platform client key — powers MiniKit / OnchainKit.
# https://portal.cdp.coinbase.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=84532

# Deployed PayFrensSplitter address, per network.
NEXT_PUBLIC_SPLITTER_ADDRESS_BASE=
NEXT_PUBLIC_SPLITTER_ADDRESS_BASE_SEPOLIA=

# ---------------------------------------------------------------------------
# Manifest — paste in what base.dev gives you after signing the association.
# ---------------------------------------------------------------------------
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------

# RPC used by the share-card renderer. Defaults to the chain's public endpoint,
# which is rate-limited — point this at a dedicated provider before the cards
# see real traffic, since every feed impression is a contract read.
RPC_URL=

# Optional Redis for notification tokens. Without it the app falls back to a
# process-local Map, which dies with the process and is not shared between
# serverless instances — fine for local dev, not for production.
REDIS_URL=
REDIS_TOKEN=

# Optional Neynar key, used to resolve wallet addresses to Farcaster profiles
# (avatars, @usernames) and to look up an @username when adding a participant.
# Without it avatars fall back to initials and only pasted addresses work.
NEYNAR_API_KEY=
