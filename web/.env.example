# ---------------------------------------------------------------------------
# Public — bundled into the client. Never put a secret behind NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Canonical origin of the deployment. Used for embed metadata, OG images and
# the farcaster.json manifest. No trailing slash.
NEXT_PUBLIC_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=PayFrens
NEXT_PUBLIC_APP_TAGLINE=Split bills in USDC on Base

# Coinbase Developer Platform client key — powers MiniKit / OnchainKit.
# https://portal.cdp.coinbase.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=84532

# Deployed PayFrensSplitter address, per network.
NEXT_PUBLIC_SPLITTER_ADDRESS_BASE=
NEXT_PUBLIC_SPLITTER_ADDRESS_BASE_SEPOLIA=

# ---------------------------------------------------------------------------
# Manifest — paste in what base.dev gives you after signing the association.
# ---------------------------------------------------------------------------
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------

# Optional Redis for notification tokens and the split index. Without it the
# app falls back to an in-memory store, which is fine for local dev only.
REDIS_URL=
REDIS_TOKEN=
